<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Core Palette  -->
    <Color x:Key="Accent">#3AB19B</Color>
    <Color x:Key="AccentLight">#56C7AF</Color>
    <Color x:Key="AccentSoft">#EAF7F3</Color>

    <Color x:Key="Surface">#FFFFFFFF</Color>
    <Color x:Key="Background">#F5F7FA</Color>
    <Color x:Key="CardStroke">#22000000</Color>

    <Color x:Key="TextPrimary">#222222</Color>
    <Color x:Key="TextSecondary">#5A6C7E</Color>
    <Color x:Key="Divider">#11000000</Color>
    <Color x:Key="Danger">#D83B01</Color>

    <!--  Brushes  -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="AccentBrushLight" Color="{StaticResource AccentLight}" />
    <SolidColorBrush x:Key="AccentBrushSoft" Color="{StaticResource AccentSoft}" />

    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStroke}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource Divider}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />

    <!--  Shadows (DropShadowEffect parameters can stay same for both)  -->
</ResourceDictionary>
