<Window x:Class="SentiScan.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Products"
        Width="1000"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Reuse card, buttons, labels from ViewProductWindow. 
             If they’re declared there, you can move shared styles into a separate file (e.g., Styles/Shared.xaml) and merge here.
             For convenience, define a few essentials locally: -->

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrushLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Theme toggle (same as we fixed earlier) -->
        <Style x:Key="ThemeToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track"
                                    CornerRadius="17"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource CardStrokeBrush}"
                                    BorderThickness="1"/>
                            <Border x:Name="Thumb"
                                    Width="28" Height="28"
                                    CornerRadius="14"
                                    Margin="3"
                                    Background="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Left"/>
                            <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                            <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrushSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid style for modern look -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource AccentBrushSoft}"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource DividerBrush}"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrushSoft}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrushSoft}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" CornerRadius="14" Padding="16" Margin="20,20,20,12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <ToggleButton x:Name="ThemeToggleButton"
                                  Style="{StaticResource ThemeToggle}"
                                  Checked="ThemeToggleButton_Checked"
                                  Unchecked="ThemeToggleButton_Unchecked"
                                  Margin="0,0,12,0"/>
                    <Button Content="Close" Click="CloseButton_Click" Style="{StaticResource ToolbarButton}"/>
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Product Management" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Search, view, edit, and delete products"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" CornerRadius="12" Padding="12" Margin="20,0,20,12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <!-- Left buttons -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Add Product" Click="AddProductButton_Click" Style="{StaticResource ToolbarButton}"/>
                    <Button Content="View" Click="ViewButton_Click" Style="{StaticResource ToolbarButton}"/>
                    <Button Content="Edit" Click="EditButton_Click" Style="{StaticResource ToolbarButton}"/>
                    <Button Content="Delete" Click="DeleteProductButton_Click" Style="{StaticResource ToolbarButton}"/>
                </StackPanel>

                <!-- Search -->
                <DockPanel LastChildFill="True" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="Search" Click="Searchbtn_Click" Style="{StaticResource ToolbarButton}" Width="99" />
                        <Button Content="Refresh" Click="Refreshbtn_Click" Style="{StaticResource ToolbarButton}"/>
                        <Button Content="Back" Click="BackButton_Click" Style="{StaticResource ToolbarButton}"/>
                    </StackPanel>
                    <TextBox x:Name="txtSearch"
                             Padding="10"
                             FontSize="14"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource CardStrokeBrush}"
                             BorderThickness="1"
                             TextChanged="txtSearch_TextChanged" Width="88"/>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- Grid -->
        <Border Grid.Row="2" CornerRadius="12" Padding="8" Margin="20,0,20,12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1">
            <DataGrid x:Name="MyProducts"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      ColumnWidth="*"
                      SelectionMode="Single"
                      ItemsSource="{Binding}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding ID}" Header="ID" Visibility="Collapsed"/>
                    <DataGridTextColumn Binding="{Binding Prefix}" Header="Prefix"/>
                    <DataGridTextColumn Binding="{Binding Name}" Header="Name"/>
                    <DataGridTextColumn Binding="{Binding Description}" Header="Description"/>
                    <DataGridTextColumn Binding="{Binding PartID}" Header="Part IDs"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="3" Margin="20,0,20,20"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="SentiScan • Products" />
    </Grid>
</Window>
