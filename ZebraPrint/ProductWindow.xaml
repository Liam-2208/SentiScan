<Window x:Class="SentiScan.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SentiScan"
        
        mc:Ignorable="d" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="AntiqueWhite"
        Title="ProductWindow" Height="500" Width="800">
    <Grid>
        <TextBlock Text="Product Management Window" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="24" FontWeight="Bold" Margin="0,15,0,0"/>

        <Button Content="Close" HorizontalAlignment="Left" VerticalAlignment="Top" Width="65" Click="CloseButton_Click" Margin="725,10,0,0" Style="{StaticResource Closebutton}"/>

        <Button Content="Add Product" HorizontalAlignment="Left" VerticalAlignment="Top" Width="124" Click="AddProductButton_Click" Margin="247,439,0,0" Style="{StaticResource Mainbutton}"/>

        <Button Content="View" Style="{StaticResource Mainbutton}" Margin="84,439,592,10" Width="124"/>

        <Button Content="Edit" Style="{StaticResource Mainbutton}" Margin="435,439,241,10" Width="124"/>

        <Button Content="Delete" Style="{StaticResource Mainbutton}" Click="DeleteProductButton_Click" Margin="592,439,84,10" Width="124"/>

        <Button Content="Back" HorizontalAlignment="Left" Click="BackButton_Click" VerticalAlignment="Top" Width="63" Margin="10,10,0,0" Style="{StaticResource Mainbutton}"/>

        <TextBox x:Name="txtSearch"  TextChanged="txtSearch_TextChanged" Style="{StaticResource textBox}" Margin="290,60,308,416" RenderTransformOrigin="0.501,0.481"/>
        <TextBlock x:Name="textSearch" MouseDown="textSearch_MouseDown" Text="Search here..." Style="{StaticResource textHint}" Margin="290,60,374,405"/>
        <Button Content="Search" FontSize="10"   Margin="530,54,211,413" Width="NaN" Background="#3AB19B" Foreground="White" Click="Searchbtn_Click"/>

        <Button Content="Refresh" FontSize="10" Margin="624,54,116,413" Width="NaN" Background="#3AB19B" Foreground="White" Click="Refreshbtn_Click"/>

        <DataGrid x:Name="MyProducts" Margin="50,108,68,77" ItemsSource="{Binding MyItems}"
          SelectionMode="Single"
          AutoGenerateColumns="True"
          AutoGeneratingColumn="MyProducts_AutoGeneratingColumn"
          AutoGeneratedColumns="MyProducts_AutoGeneratedColumns"
          CanUserAddRows="false"
         />



    </Grid>
</Window>
