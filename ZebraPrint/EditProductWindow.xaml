<Window
    x:Class="SentiScan.EditProductWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Edit Product"
    Width="900"
    Height="700"
    Background="AliceBlue"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="0,0,0,20"
            HorizontalAlignment="Center"
            FontSize="28"
            FontWeight="Bold"
            Text="Edit Product" />

        <StackPanel
            Grid.Row="1"
            Margin="0"
            VerticalAlignment="Top"
            Orientation="Vertical">

            <!--  Prefix  -->
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Width="120"
                    VerticalAlignment="Center"
                    Text="Prefix:" />
                <TextBox x:Name="PrefixBox" Width="300" />
            </StackPanel>

            <!--  Name  -->
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Width="120"
                    VerticalAlignment="Center"
                    Text="Name:" />
                <TextBox
                    x:Name="NameBox"
                    Width="300"
                    IsReadOnly="True" />
            </StackPanel>

            <!--  Description  -->
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Width="120"
                    VerticalAlignment="Center"
                    Text="Description:" />
                <TextBox
                    x:Name="DescriptionBox"
                    Width="300"
                    Height="80"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  Image  -->
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Width="120"
                    VerticalAlignment="Center"
                    Text="Image Path:" />
                <TextBox
                    x:Name="ImageBox"
                    Width="300"
                    IsReadOnly="True" />
                <Button
                    Width="111"
                    Height="50"
                    Margin="10,0,0,0"
                    Click="BrowseImage_Click"
                    Content="Browse"
                    Style="{StaticResource Mainbutton}" />
            </StackPanel>

            <!--  Parts Selector  -->
            <TextBlock
                Margin="0,20,0,5"
                FontWeight="Bold"
                Text="Assign Parts:" />

            <DataGrid
                x:Name="PartsGrid"
                Height="250"
                AutoGenerateColumns="False"
                SelectionMode="Single">

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Select">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="Selected" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding ID}"
                        Header="ID" />
                    <DataGridTextColumn
                        Width="200"
                        Binding="{Binding Name}"
                        Header="Name" />

                </DataGrid.Columns>
            </DataGrid>

            <!--  Buttons  -->
            <StackPanel
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="120"
                    Margin="10"
                    Click="Save_Click"
                    Content="Save"
                    Style="{StaticResource Mainbutton}" />
                <Button
                    Width="120"
                    Margin="10"
                    Click="Cancel_Click"
                    Content="Cancel"
                    Style="{StaticResource Mainbutton}" />
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>


