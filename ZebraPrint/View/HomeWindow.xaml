<Window x:Class="SentiScan.View.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SentiScan.View"
           mc:Ignorable="d" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="AntiqueWhite"
    Title="LoginWindow" Height="500" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1.5*" />
        </Grid.ColumnDefinitions>

        <Border CornerRadius="10 0 0 10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#3AA9AD" Offset="0"/>
                    <GradientStop Color="#3AADA1" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Canvas>
                    <Polygon Points="0,0 800,0 0,500" Fill="#2E7C7F" Opacity="0.5" HorizontalAlignment="Left" VerticalAlignment="Center" Width="797"/>
                    <Polygon Points="0,0 800,0 300,500" Fill="#2E7C7F" Opacity="0.5"/>
                    <Polygon Points="0,0 800,0 0,500" Fill="#2E7C7F" Opacity="0.5"/>
                    <Ellipse Margin="250 450 0 0" Width="40" Height="40" Fill="#2E7C7F"/>
                </Canvas>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SentiScan" Style="{StaticResource titletext}"/>
                    <TextBlock Text="Server Name - 192.168.10.33" Style="{StaticResource normalText}" Opacity="0.8" Margin="20 30"/>
                    <TextBlock Text="Database Name - SP2025" Style="{StaticResource normalText}" Opacity="0.8"/>
                </StackPanel>
            </Grid>
        </Border>



        <Border Background="#FFFFFF" Grid.Column="1" CornerRadius="0 10 10 0" MouseDown="Border_MouseDown">
            <StackPanel VerticalAlignment="Center">
                <Button Content="Manage Products" Click="ProductButton_Click" Style="{StaticResource Mainbutton}"/>
                <Button Content="Manage Parts" Click="Button_Click" Style="{StaticResource Mainbutton}"/>
                <Button Content="Manage Labels" Click="Button_Click" Style="{StaticResource Mainbutton}"/>
                <Button Content="Manage Orders" Click="Button_Click" Style="{StaticResource Mainbutton}"/>
                <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click" Style="{StaticResource Closebutton}" Margin="70"/>

            </StackPanel>

        </Border>


    </Grid>
</Window>
