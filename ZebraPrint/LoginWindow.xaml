<Window
    x:Class="SentiScan.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SentiScan"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="LoginWindow"
    Width="800"
    Height="500"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1.5*" />
        </Grid.ColumnDefinitions>

        <Border CornerRadius="10 0 0 10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#3AA9AD" />
                    <GradientStop Offset="1" Color="#3AADA1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Canvas>
                    <Polygon
                        Fill="#2E7C7F"
                        Opacity="0.5"
                        Points="0,0 800,0 0,500" />
                    <Polygon
                        Fill="#2E7C7F"
                        Opacity="0.5"
                        Points="0,0 800,0 300,500" />
                    <Polygon
                        Fill="#2E7C7F"
                        Opacity="0.5"
                        Points="0,0 800,0 0,500" />
                    <Ellipse
                        Width="40"
                        Height="40"
                        Margin="250,450,0,0"
                        Fill="#2E7C7F" />
                </Canvas>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource titletext}" Text="SentiScan" />
                    <TextBox
                        x:Name="txtServerName"
                        Margin="0"
                        IsReadOnly="True"
                        Opacity="0.8"
                        Style="{StaticResource textBox}"
                        Text="Server Name?" />
                    <TextBox
                        x:Name="txtDataBaseName"
                        Margin="0"
                        IsReadOnly="True"
                        Opacity="0.8"
                        RenderTransformOrigin="0.414,0.163"
                        Style="{StaticResource textBox}"
                        Text="DataBase Name?" />
                    <TextBox
                        x:Name="txtDataUser"
                        Margin="0"
                        IsReadOnly="True"
                        Opacity="0.8"
                        Style="{StaticResource textBox}"
                        Text="Database Username" />
                    <PasswordBox
                        x:Name="txtDataPass"
                        Margin="0"
                        Opacity="0.8"
                        Style="{StaticResource textBox}"
                        Visibility="Hidden" />
                    <TextBlock
                        Opacity="0.8"
                        Style="{StaticResource normalText}"
                        Text="Server Settings" />
                    <CheckBox
                        x:Name="chkServerSettings"
                        HorizontalAlignment="Center"
                        Checked="chkServerSettings_Checked"
                        Content="Edit Server Settings"
                        Foreground="White"
                        Unchecked="chkServerSettings_Unchecked" />
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            Background="#FFFFFF"
            CornerRadius="0 10 10 0"
            MouseDown="Border_MouseDown">
            <StackPanel>
                <TextBlock
                    Margin="0,40,0,0"
                    Foreground="#333333"
                    Style="{StaticResource titletext}"
                    Text="Sign in to connect" />
                <StackPanel
                    Margin="0,20"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal" />

                <TextBlock
                    Margin="0,-30,10,20"
                    Foreground="#878787"
                    Style="{StaticResource normalText}"
                    Text="Please enter your username and password to enter:" />

                <Border
                    Margin="70,7"
                    BorderBrush="#acb0af"
                    BorderThickness="1"
                    CornerRadius="5">
                    <Grid Margin="7,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="textUsername"
                            MouseDown="textUsername_MouseDown"
                            Style="{StaticResource textHint}"
                            Text="Username..." />
                        <TextBox
                            x:Name="txtUsername"
                            Style="{StaticResource textBox}"
                            TextChanged="txtUsername_TextChanged" />
                    </Grid>
                </Border>
                <Border
                    Margin="70,7"
                    BorderBrush="#acb0af"
                    BorderThickness="1"
                    CornerRadius="5">
                    <Grid Margin="7,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="textPassword"
                            MouseDown="textPassword_MouseDown"
                            Style="{StaticResource textHint}"
                            Text="Password..." />
                        <PasswordBox
                            x:Name="txtPassword"
                            PasswordChanged="txtPassword_TextChanged"
                            Style="{StaticResource textBox}" />
                    </Grid>
                </Border>

                <Button
                    Name="btnOK"
                    Click="Button_Click"
                    Content="Connect"
                    IsDefault="True"
                    Style="{StaticResource Mainbutton}" />


                <Button
                    Name="CloseButton"
                    Margin="120"
                    Click="CloseButton_Click"
                    Content="Close"
                    Style="{StaticResource Closebutton}" />

            </StackPanel>



        </Border>

    </Grid>
</Window>
