<Window
    x:Class="SentiScan.ViewProductWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="View Product"
    Width="940"
    Height="800"
    Background="{DynamicResource BackgroundBrush}"
    Icon="{x:Null}"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!--  Typography  -->
        <FontFamily x:Key="UIFamily">Segoe UI Variable</FontFamily>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <!--  Card style  -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,24" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="20"
                        Opacity="0.18"
                        ShadowDepth="2" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Read-only input  -->
        <Style x:Key="ReadOnlyBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FontFamily" Value="{StaticResource UIFamily}" />
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!--  Section label  -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UIFamily}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>

        <!--  Divider (style, not single element instance)  -->
        <Style x:Key="DividerStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{DynamicResource DividerBrush}" />
            <Setter Property="Margin" Value="0,12,0,12" />
        </Style>

        <!--  Icon Button  -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrushSoft}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Primary button  -->
        <Style
            x:Key="PrimaryButton"
            BasedOn="{StaticResource IconButton}"
            TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrushLight}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.92" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Theme Toggle (Sun/Moon)  -->

        <Style x:Key="ThemeToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border
                                x:Name="Track"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="17" />

                            <!--  DEFAULT (Light) -->
                            <Border
                                x:Name="Thumb"
                                Width="28"
                                Height="28"
                                Margin="3"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="14">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="10"
                                        Opacity="0.35"
                                        ShadowDepth="1" />
                                </Border.Effect>
                            </Border>

                            <!--  Sun/Moon icons  -->
                            <TextBlock
                                x:Name="Sun"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFont}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="&#xE706;" />

                            <TextBlock
                                x:Name="Moon"
                                Margin="0,0,10,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFont}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="&#xE708;" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!--  DARK MODE  -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrushSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!--  Chip (NOTE: no Child setter; content comes from ItemTemplate)  -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="{DynamicResource AccentBrushSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  HEADER  -->
        <Grid Grid.Row="0" Margin="24,22,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="18"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource CardStrokeBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Icon circle  -->
                    <Border
                        Width="48"
                        Height="48"
                        Background="{DynamicResource AccentBrushSoft}"
                        CornerRadius="24">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFont}"
                            FontSize="22"
                            Foreground="{DynamicResource AccentBrush}"
                            Text="&#xE71D;" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock
                            x:Name="HeaderTitle"
                            FontFamily="{StaticResource UIFamily}"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="Product Details" />
                        <TextBlock
                            FontFamily="{StaticResource UIFamily}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="Read-only view with live Light/Dark theme" />
                    </StackPanel>

                    <!--  Theme toggle + Close (no StackPanel.Spacing for broad compatibility)  -->
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ToggleButton
                            x:Name="ThemeToggleButton"
                            Margin="0,0,12,0"
                            Checked="ThemeToggleButton_Checked"
                            Style="{StaticResource ThemeToggle}"
                            ToolTip="Toggle theme"
                            Unchecked="ThemeToggleButton_Unchecked" />
                        <Button
                            Width="44"
                            Height="44"
                            Click="Close_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="Close">
                            <TextBlock
                                FontFamily="{StaticResource IconFont}"
                                FontSize="18"
                                Text="&#xE8BB;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!--  CONTENT  -->
        <ScrollViewer
            Grid.Row="1"
            Margin="24,0,24,18"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  Product card  -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <!--  Image preview  -->
                        <Border
                            Grid.Column="0"
                            Margin="0,0,16,0"
                            Padding="8"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <Grid>

                                <Image
                                    x:Name="ProductImage"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True"
                                    Stretch="Uniform" />

                                <TextBlock
                                    x:Name="ImageFallback"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="No image available" />
                            </Grid>
                        </Border>

                        <!--  Fields  -->
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                FontFamily="{StaticResource UIFamily}"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="General Information" />
                            <Rectangle Style="{StaticResource DividerStyle}" />

                            <TextBlock Style="{StaticResource SectionLabel}" Text="Prefix" />
                            <TextBox x:Name="PrefixBox" Style="{StaticResource ReadOnlyBox}" />

                            <TextBlock
                                Margin="0,10,0,0"
                                Style="{StaticResource SectionLabel}"
                                Text="Name" />
                            <TextBox x:Name="NameBox" Style="{StaticResource ReadOnlyBox}" />

                            <TextBlock
                                Margin="0,10,0,0"
                                Style="{StaticResource SectionLabel}"
                                Text="Description" />
                            <TextBox
                                x:Name="DescriptionBox"
                                Height="110"
                                Style="{StaticResource ReadOnlyBox}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,10,0,0"
                                Style="{StaticResource SectionLabel}"
                                Text="Image Path" />
                            <DockPanel LastChildFill="True">
                                <TextBox
                                    x:Name="ImageBox"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource ReadOnlyBox}" />
                                <Button
                                    Width="44"
                                    Height="40"
                                    Margin="0,0,8,0"
                                    Click="CopyImagePath_Click"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Copy path">
                                    <TextBlock
                                        FontFamily="{StaticResource IconFont}"
                                        FontSize="16"
                                        Text="&#xE8C8;" />
                                </Button>
                                <Button
                                    Width="44"
                                    Height="40"
                                    Click="OpenImage_Click"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Open image">
                                    <TextBlock
                                        FontFamily="{StaticResource IconFont}"
                                        FontSize="16"
                                        Text="&#xE8A7;" />
                                </Button>
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Parts card  -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock
                            FontFamily="{StaticResource UIFamily}"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="Assigned Parts" />
                        <Rectangle Style="{StaticResource DividerStyle}" />

                        <!--  Chips  -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="PartsChips">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}">
                                            <TextBlock
                                                FontSize="14"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!--  FOOTER  -->
        <Grid Grid.Row="2" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                FontFamily="{StaticResource UIFamily}"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="View-only • SentiScan" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button
                    Width="160"
                    Height="44"
                    Click="Close_Click"
                    Content="Close"
                    Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
