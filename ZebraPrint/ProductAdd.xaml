<Window x:Class="SentiScan.ProductAdd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SentiScan"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="AntiqueWhite"
        Title="LoginWindow" Height="700" Width="1000">
    <Grid>
        <TextBlock Text="Add Products" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>


        <Button Content="Close" HorizontalAlignment="Left" VerticalAlignment="Top" Width="65" Click="CloseButton_Click" Margin="725,10,0,0" Style="{StaticResource Closebutton}"/>


        <TextBlock Text="Prefix :" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150,100,0,0" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Name :" HorizontalAlignment="Left" Margin="148,175,0,297" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Description :" HorizontalAlignment="Left" FontSize="20" FontWeight="SemiBold" Foreground="Black" Height="39" VerticalAlignment="Bottom" Margin="98,0,0,211"/>
        <TextBox x:Name="Prefixtxt" HorizontalAlignment="Left" Height="30" Margin="250,100,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="500" Style="{StaticResource textBox}"/>
        <TextBox x:Name="ProductNametxt" HorizontalAlignment="Left" Height="30" Margin="250,175,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="500" Style="{StaticResource textBox}"/>
        <TextBox x:Name="Descriptiontxt" HorizontalAlignment="Left" Height="100" Margin="250,250,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="500" Style="{StaticResource textBox}"/>


        <Button Content="Add Product" HorizontalAlignment="Left" Click="Button_Click_1" VerticalAlignment="Top" Width="124" Margin="338,400,0,0" Style="{StaticResource Mainbutton}"/>
        <Button Content="Back" HorizontalAlignment="Left" Click="BackButton_Click" VerticalAlignment="Top" Width="63" Margin="10,10,0,0" Style="{StaticResource Mainbutton}"/>
    </Grid>
</Window>
