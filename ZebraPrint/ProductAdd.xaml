<Window
    x:Class="SentiScan.ProductAdd"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SentiScan"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="LoginWindow"
    Width="1200"
    Height="900"
    AllowsTransparency="True"
    Background="AntiqueWhite"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46*" />
            <RowDefinition Height="129*" />
        </Grid.RowDefinitions>
        <TextBlock
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            FontSize="28"
            FontWeight="Bold"
            Text="Add Products" />


        <Button
            Width="65"
            Margin="1125,16,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="CloseButton_Click"
            Content="Close"
            Style="{StaticResource Closebutton}" />


        <TextBlock
            Margin="150,100,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="20"
            FontWeight="SemiBold"
            Text="Prefix :" />
        <TextBlock
            Grid.RowSpan="2"
            Margin="148,175,0,297"
            HorizontalAlignment="Left"
            FontSize="20"
            FontWeight="SemiBold"
            Text="Name :" />
        <TextBlock
            Grid.Row="1"
            Height="40"
            Margin="98,0,0,538"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            FontSize="20"
            FontWeight="SemiBold"
            Foreground="Black"
            Text="Description :" />
        <TextBlock
            Grid.Row="1"
            Height="40"
            Margin="98,0,0,413"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            FontSize="20"
            FontWeight="SemiBold"
            Foreground="Black"
            Text="Search IMG :" />
        <TextBox
            x:Name="Prefixtxt"
            Width="500"
            Height="30"
            Margin="0,100,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Style="{StaticResource textBox}"
            TextWrapping="Wrap" />
        <TextBox
            x:Name="ProductNametxt"
            Grid.RowSpan="2"
            Width="500"
            Height="30"
            Margin="0,175,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Style="{StaticResource textBox}"
            TextWrapping="Wrap" />
        <TextBox
            x:Name="Descriptiontxt"
            Grid.Row="1"
            Width="500"
            Height="100"
            Margin="0,55,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Style="{StaticResource textBox}"
            TextWrapping="Wrap" />



        <DataGrid
            x:Name="MyParts"
            Grid.Row="1"
            Margin="181,301,165,125"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            SelectionMode="Single">

            <DataGrid.Columns>

                <!-- Checkbox column -->
                <DataGridTemplateColumn Header="Select">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox
                        Checked="PartCheckBox_Checked"
                        Unchecked="PartCheckBox_Unchecked"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Actual DB columns -->
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" />
                <DataGridTextColumn Header="Prefix" Binding="{Binding Prefix}" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" />

            </DataGrid.Columns>
        </DataGrid>



        <Button
            x:Name="UploadButton"
            Grid.Row="1"
            Margin="299,191,309,390"
            Click="UploadButton_Click"
            Content="Upload Image"
            FontSize="18"
            RenderTransformOrigin="0.5,0.5" />


        <Button
            Grid.Row="1"
            Width="124"
            Margin="533,580,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="Button_Click_1"
            Content="Add Product"
            Style="{StaticResource Mainbutton}" />
        <Button
            Width="63"
            Margin="10,16,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="BackButton_Click"
            Content="Back"
            Style="{StaticResource Mainbutton}" />
    </Grid>
</Window>
